# ============================================================
# .env.example
# ============================================================
# Salin file ini menjadi .env dan isi nilainya.
# JANGAN commit file .env ke repository.
# Tambahkan .env ke dalam .gitignore Anda.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT ──────────────────────────────────────────────────────
# Ganti dengan string acak yang panjang dan kompleks
# Generate contoh: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_strong_jwt_secret_key_here
JWT_EXPIRES_IN=1h

# ── Database (MySQL / Sequelize) ─────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_DIALECT=mysql

# ── Database (MongoDB / Mongoose) — aktifkan jika pakai MongoDB
# MONGO_URI=mongodb://localhost:27017/your_database_name

# ── Rate Limiter (opsional — override default) ───────────────
# LOGIN_LIMIT_MAX=5
# LOGIN_LIMIT_WINDOW_MS=900000
# GLOBAL_LIMIT_MAX=100
# GLOBAL_LIMIT_WINDOW_MS=900000
