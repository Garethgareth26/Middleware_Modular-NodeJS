{
  "name": "middleware-modular-nodejs",
  "version": "1.0.0",
  "description": "Modular middleware for RESTful API authentication and authorization using Node.js and Express.js. Covers JWT verification, RBAC, rate limiting, input validation, error handling, and request logging.",
  "main": "examples/server.example.js",
  "keywords": [
    "middleware",
    "nodejs",
    "express",
    "jwt",
    "authentication",
    "authorization",
    "rbac",
    "rate-limiting",
    "validation",
    "security",
    "restful-api"
  ],
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "node examples/server.example.js",
    "dev": "nodemon examples/server.example.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
